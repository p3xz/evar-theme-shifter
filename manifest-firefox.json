{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "EvarTheme Shifter"
  },
  "content_scripts": [
    {
      "css": [
        "dark.css"
      ],
      "js": [
        "content.js"
      ],
      "matches": [
        "*://*.kristujayanti.edu.in/*",
        "*://kristujayanti.edu.in/*",
        "*://*.kristujayantiexamlms.com/*",
        "*://kristujayantiexamlms.com/*",
        "*://*.wikipedia.org/*",
        "*://*.reddit.com/*",
        "*://*.github.com/*",
        "*://*.stackoverflow.com/*",
        "*://*.medium.com/*",
        "*://news.ycombinator.com/*",
        "*://*.developer.mozilla.org/*"
      ],
      "run_at": "document_start"
    }
  ],
  "description": "Dark mode for your college portal, LMS, Wikipedia, Reddit, GitHub and more.",
  "host_permissions": [
    "*://*.kristujayanti.edu.in/*",
    "*://kristujayanti.edu.in/*",
    "*://*.kristujayantiexamlms.com/*",
    "*://kristujayantiexamlms.com/*",
    "*://*.wikipedia.org/*",
    "*://*.reddit.com/*",
    "*://*.github.com/*",
    "*://*.stackoverflow.com/*",
    "*://*.medium.com/*",
    "*://news.ycombinator.com/*",
    "*://*.developer.mozilla.org/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "EvarTheme Shifter",
  "permissions": [
    "storage"
  ],
  "version": "1.4.6",
  "browser_specific_settings": {
    "gecko": {
      "id": "evar-theme-shifter@p3xz.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}