{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "EvarTheme Shifter"
  },
  "content_scripts": [
    {
      "css": [
        "dark.css"
      ],
      "js": [
        "content.js"
      ],
      "matches": [
        "*://*.kristujayanti.edu.in/*",
        "*://kristujayanti.edu.in/*",
        "*://*.kristujayantiexamlms.com/*",
        "*://kristujayantiexamlms.com/*",
        "*://*.wikipedia.org/*",
        "*://*.reddit.com/*",
        "*://*.github.com/*",
        "*://*.stackoverflow.com/*",
        "*://*.medium.com/*",
        "*://news.ycombinator.com/*",
        "*://*.developer.mozilla.org/*"
      ],
      "run_at": "document_start"
    }
  ],
  "description": "A general dark mode extension for your college portal, LMS, Wikipedia, Reddit, GitHub, Stack Overflow, Medium, Hacker News and MDN. Proper per-element dark theme, no global invert.",
  "host_permissions": [
    "*://*.kristujayanti.edu.in/*",
    "*://kristujayanti.edu.in/*",
    "*://*.kristujayantiexamlms.com/*",
    "*://kristujayantiexamlms.com/*",
    "*://*.wikipedia.org/*",
    "*://*.reddit.com/*",
    "*://*.github.com/*",
    "*://*.stackoverflow.com/*",
    "*://*.medium.com/*",
    "*://news.ycombinator.com/*",
    "*://*.developer.mozilla.org/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "EvarTheme Shifter",
  "permissions": [
    "storage"
  ],
  "version": "1.4.1"
}